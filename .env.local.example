# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:9000

# ── InsForge backend ─────────────────────────────────────────────────────────
NEXT_PUBLIC_INSFORGE_URL=https://your-app.insforge.app
NEXT_PUBLIC_INSFORGE_ANON_KEY=your_anon_key_here
# Server-only project API key (ik_...). Bypasses RLS — used by server routes via
# src/lib/insforge/server.ts. NEVER expose to the browser. Required.
INSFORGE_API_KEY=ik_replace_with_project_api_key

# ── Internal auth ────────────────────────────────────────────────────────────
ALIGNO_API_KEY=replace_with_a_long_random_secret

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_replace_with_resend_api_key
EMAIL_FROM="AlignoCRM <info@alignocrm.com>"
# Delivery + inbound webhook signing secrets (Svix), from the Resend dashboard.
RESEND_WEBHOOK_SECRET=whsec_replace_me
RESEND_INBOUND_WEBHOOK_SECRET=whsec_replace_me

# ── Messaging center domains ─────────────────────────────────────────────────
MESSAGING_EMAIL_DOMAIN=send.alignocrm.com
MESSAGING_REPLY_DOMAIN=reply.alignocrm.com
# Public base URL used to reconstruct the exact URL for Twilio signature
# validation and to build webhook/unsubscribe links (REQ-SEC-02). Must match the
# URL Twilio/Resend actually call, scheme included.
MESSAGING_PUBLIC_BASE_URL=https://www.alignocrm.com
# HMAC secret shared by one-click unsubscribe tokens AND per-campaign processor
# job tokens (REQ-SEC-08/16). 32+ random bytes.
MESSAGING_TOKEN_SECRET=replace_with_a_long_random_secret

# ── SMS (Twilio) ─────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=AC_replace_me
TWILIO_AUTH_TOKEN=replace_me
TWILIO_MESSAGING_SERVICE_SID=MG_replace_me

# ── Background jobs (Trigger.dev) ────────────────────────────────────────────
TRIGGER_SECRET_KEY=tr_replace_me
