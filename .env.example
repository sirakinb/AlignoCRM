# Copy to .env.local and fill in real values.

# InsForge (required)
NEXT_PUBLIC_INSFORGE_URL=https://uvf4r7ds.us-east.insforge.app
NEXT_PUBLIC_INSFORGE_ANON_KEY=anon_...
INSFORGE_API_KEY=ik_...

# Resend (existing workflow + conversation email fallback)
RESEND_API_KEY=re_...
EMAIL_FROM=AlignoCRM <noreply@contact.alignocrm.com>

# Messaging domains. Production uses contact.alignocrm.com for BOTH sending and
# replies — it is the verified Resend domain (SPF/DKIM + inbound MX). Reply-To
# is "<workspace-alias>@<reply-domain>" (pretty alias, workspace_email_aliases
# table); legacy "r+<token>@" addresses keep routing via conversations.
MESSAGING_EMAIL_DOMAIN=contact.alignocrm.com
MESSAGING_REPLY_DOMAIN=contact.alignocrm.com

# Twilio (existing SMS)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_MESSAGING_SERVICE_SID=MG...

# ── NEW: Email account connections (Milestone 1) ──────────────────────────────

# 32-byte base64 AES key for OAuth token encryption.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
OAUTH_TOKEN_ENCRYPTION_KEY=

# Google OAuth (Gmail)
GOOGLE_OAUTH_CLIENT_ID=...
GOOGLE_OAUTH_CLIENT_SECRET=...
GOOGLE_OAUTH_REDIRECT_URI=https://app.alignocrm.com/api/messaging/email/oauth/google/callback

# Microsoft OAuth (Outlook / Office365)
MICROSOFT_OAUTH_CLIENT_ID=...
MICROSOFT_OAUTH_CLIENT_SECRET=...
MICROSOFT_OAUTH_REDIRECT_URI=https://app.alignocrm.com/api/messaging/email/oauth/microsoft/callback
MICROSOFT_OAUTH_TENANT=common

# For local development, register localhost redirect URIs with each provider
# and point the *_REDIRECT_URI vars at them, e.g.:
#   http://localhost:3000/api/messaging/email/oauth/google/callback
#   http://localhost:3000/api/messaging/email/oauth/microsoft/callback

# ── NEW: Inbound email sync scheduler (Milestone 2) ───────────────────────────

# Shared secret for the Vercel Cron endpoint /api/cron/email-sync (runs every
# 5 minutes, see vercel.json). Vercel automatically sends it as
# `Authorization: Bearer ${CRON_SECRET}` when this env var is set on the
# project. Generate with: openssl rand -base64 32
CRON_SECRET=

# TrustHub / A2P status callbacks use:
#   ${MESSAGING_PUBLIC_BASE_URL}/api/webhooks/twilio/trusthub
# Ensure MESSAGING_PUBLIC_BASE_URL is set (same as inbound SMS).
MESSAGING_PUBLIC_BASE_URL=https://app.alignocrm.com
